# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Search Provider Selection: "google", "tineye", or "multi"
SEARCH_PROVIDER="google"

# Google Cloud Vision API Key (supports Web Detection feature for reverse visual search)
# Alternatively, GOOGLE_VISION_API_KEY can be used
GOOGLE_CLOUD_API_KEY=""

# Google Cloud Project ID (optional, if using project scoping)
GOOGLE_CLOUD_PROJECT_ID=""

# TinEye Commercial Reverse Image Search API Key
TINEYE_API_KEY=""

# SerpApi Google Lens API Key (optional alternate provider)
SERPAPI_API_KEY=""

# Timeout in seconds for visual search requests (default: 30)
SEARCH_TIMEOUT_SECONDS=30

# Maximum results to return (default: 50)
MAX_RESULTS=50

